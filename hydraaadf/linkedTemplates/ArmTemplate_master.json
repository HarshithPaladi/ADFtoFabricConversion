{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "hydraaadf"
		},
		"AzureDataLakeStorageConnection_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageConnection'"
		},
		"AzureSqlDBConnection_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDBConnection'"
		},
		"AzureDataLakeStorageConnection_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://hydrablobstorage.dfs.core.windows.net/"
		},
		"AzureSqlDBConnection_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "hydraserver.database.windows.net"
		},
		"AzureSqlDBConnection_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "hydradatabase"
		},
		"AzureSqlDBConnection_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "hydraadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "hydraaadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorageConnection_accountKey": {
						"value": "[parameters('AzureDataLakeStorageConnection_accountKey')]"
					},
					"AzureSqlDBConnection_password": {
						"value": "[parameters('AzureSqlDBConnection_password')]"
					},
					"AzureDataLakeStorageConnection_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageConnection_properties_typeProperties_url')]"
					},
					"AzureSqlDBConnection_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDBConnection_properties_typeProperties_server')]"
					},
					"AzureSqlDBConnection_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDBConnection_properties_typeProperties_database')]"
					},
					"AzureSqlDBConnection_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDBConnection_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}